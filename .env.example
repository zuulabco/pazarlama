# ─── Site ───────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Firebase (client) — Console > Project settings > Your apps ───
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Google One Tap (sağ üstte "Google ile devam et" kutusu): Firebase konsolu → Authentication → Sign-in method → Google → Web SDK configuration → "Web client ID".
# Aynı OAuth istemcisinin "Authorized JavaScript origins" listesine siteniz (https://adspine.app) ve http://localhost:3000 eklenmelidir. Boş bırakılırsa özellik kapalıdır.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ─── Firebase Admin (server) — Project settings > Service accounts ───
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# Tek satır, \n kaçışlarıyla ve tırnak içinde: "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_ADMIN_PRIVATE_KEY=

# ─── Supabase — Project settings > API ───
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Apify (Müşteri bul: kişi ve iş e-postası) ───
APIFY_TOKEN=

# ─── JEV / TypeSafe AI (kişi skorlaması: profilinize uyum) ───
TYPESAFE_API_KEY=

# ─── Ortak kişi havuzu: 0 yazarsanız kapanır (supabase/migrations/0016_lead_pool.sql gerekir) ───
# LEAD_POOL=1

# ─── NVIDIA NIM (LLM) ───
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
