# ─── Site ───────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Firebase (client) — Console > Project settings > Your apps ───
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ─── Firebase Admin (server) — Project settings > Service accounts ───
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# Tek satır, \n kaçışlarıyla ve tırnak içinde: "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_ADMIN_PRIVATE_KEY=

# ─── Supabase — Project settings > API ───
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Apify (Google Maps Scraper) ───
APIFY_TOKEN=
# Webhook doğrulaması için rastgele uzun bir değer (örn. openssl rand -hex 32)
APIFY_WEBHOOK_SECRET=

# ─── JEV / TypeSafe AI ───
TYPESAFE_API_KEY=

# ─── NVIDIA NIM (LLM) ───
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
